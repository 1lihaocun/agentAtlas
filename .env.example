# AgentAtlas 模型配置。复制为工作目录根部的 .env 后填写。
# 仅从此文件读取模型配置，不继承 Hermes 或进程环境变量。
# 值按字面解析；不展开 ${变量}。请勿提交包含真实密钥的 .env。

# 翻译：openai / glm / zai / openrouter / ollama
ATLAS_TRANSLATION_PROVIDER=openai
# API 基础地址，不含 /chat/completions；留空使用 provider 默认地址
ATLAS_TRANSLATION_BASE_URL=
ATLAS_TRANSLATION_MODEL=
# Ollama 可留空
ATLAS_TRANSLATION_API_KEY=

# Embedding：兼容 OpenAI embeddings 接口
# API 基础地址，例如 https://your-provider.example/v1
ATLAS_EMBEDDING_BASE_URL=
ATLAS_EMBEDDING_MODEL=
ATLAS_EMBEDDING_API_KEY=
# 留空由服务决定；指定时范围 1–65536
ATLAS_EMBEDDING_DIMENSIONS=
# 范围 1–128
ATLAS_EMBEDDING_BATCH_SIZE=16
# 英文逗号分隔；留空禁止发送任何类别，默认排除 config/session/log/other
ATLAS_EMBEDDING_CATEGORIES=instruction,memory,skill,reference,command,hook
